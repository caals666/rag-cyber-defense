# Whitelist: everything is ignored unless listed below.
/*
!/.gitignore
!/LICENSE
!/README.md
!/.env.example
!/docker-compose.yml
!/backend/
!/frontend/
!/neo4j/
!/data/
!/docs/
!/.github/
!/build_datasets.py
!/build_attack_path_dataset.py

# inside data/, keep the four source datasets and the processed reports
/data/*
!/data/raw/
!/data/processed/
# 70 MB, regenerate with build_attack_path_dataset.py
/data/processed/cyber_attack_path_dataset.csv

# never commit
.env
nvdcve-*.json
__pycache__/
*.pyc
node_modules/
.next/
